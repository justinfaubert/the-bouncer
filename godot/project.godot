; The Bouncer: Wednesday, the test shift, through his eyes, printed.
; Built from content/ink and content/data by tools/build.mjs; see README.md.

config_version=5

[application]

config/name="The Bouncer"
config/description="Wednesday night at the Sovereign, from the door."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.105882, 0.129412, 0.188235, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="The Bouncer"

[audio]

driver/enable_input=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1

[shader_globals]

cut_scale={
"type": "float",
"value": 1.0
}
