; The door post, printed: a look test for The Bouncer.
; The door scene from sketches/door-camera, run through the press: three inks on the paper.

config_version=5

[application]
config/name="The Bouncer: the door, printed"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
